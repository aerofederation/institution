{
  "name": "afi-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location .eslintcache",
    "lint:fix": "eslint --cache --cache-location .eslintcache --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run build:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.mts",
    "db:link": "tsx scripts/db.mts link",
    "db:push": "tsx scripts/db.mts push",
    "db:diff": "tsx scripts/db.mts diff",
    "db:status": "tsx scripts/db.mts status",
    "db:types": "tsx scripts/generate-types.mts --remote",
    "db:types:local": "tsx scripts/generate-types.mts",
    "db:types:check": "tsx scripts/compare-types.mts",
    "db:seed": "tsx supabase/seed/run.mts",
    "verify:supabase": "tsx scripts/verify-supabase.mts",
    "verify:email": "node --conditions=react-server --import tsx scripts/verify-email.mts",
    "verify:cleanup": "tsx scripts/cleanup-verification.mts",
    "db:repair": "tsx scripts/db.mts repair",
    "bootstrap:hq": "tsx scripts/bootstrap-hq.mts",
    "verify:application": "tsx scripts/verify-application-flow.mts",
    "verify:activation": "tsx scripts/verify-activation-flow.mts",
    "invite:admin": "node --conditions=react-server --import tsx scripts/invite-institution-admin.mts",
    "verify:institution": "tsx scripts/verify-institution-workspace.mts",
    "verify:teaching": "tsx scripts/verify-teaching.mts",
    "verify:messaging": "tsx scripts/verify-messaging.mts",
    "verify:assessment": "tsx scripts/verify-assessment-engine.mts",
    "fixture:assessment": "tsx scripts/dev-assessment-fixture.mts",
    "inspect:assessment": "tsx scripts/inspect-assessment-schema.mts",
    "verify:ai": "node --conditions=react-server --import tsx scripts/verify-ai-grading.mts",
    "build:check": "node scripts/build-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Aero Federation of India — Digital Institution & AI Education Platform",
  "engines": {
    "node": ">=20.0.0"
  }
}
